# Managed Manus demo
NODE_ENV=development
API_PORT=3001
API_INTERNAL_ORIGIN=http://127.0.0.1:3001
DEMO_MODE=true
# Local demo login is available only outside production. VPS production requires JWT_SECRET,
# AUTH_USER_EMAIL, and AUTH_PASSWORD_HASH (bcryptjs); never store a production password here.
JWT_SECRET=
AUTH_USER_EMAIL=
AUTH_PASSWORD_HASH=
COOKIE_SECURE=true
# PostgreSQL target on VPS is configured in deploy/vps/.env.example
