# Copier vers deploy/vps/.env puis remplacer tous les placeholders par des secrets distincts
POSTGRES_DB=payment_sandbox
POSTGRES_USER=psa
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
REDIS_PASSWORD=REPLACE_WITH_DIFFERENT_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://psa:REPLACE_WITH_LONG_RANDOM_SECRET@postgres:5432/payment_sandbox?schema=public
JWT_SECRET=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
AUTH_USER_EMAIL=admin@example.com
# Hash bcryptjs (cost >= 12); jamais mettre ici le mot de passe en clair
AUTH_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH
COOKIE_SECURE=true
DEMO_MODE=false
