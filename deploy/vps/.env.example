# Copier dans deploy/vps/.env et remplacer toutes les valeurs d’exemple
POSTGRES_DB=payment_sandbox
POSTGRES_USER=psa
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_SECRET
